# Copy to .env (never committed). One file per instance.
# Local, with `supabase start`: the URL and anon key that `supabase status` prints.
# Local, with the Docker-free stand-in (`bun run dev:backend`): the values below work as they are.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-dev-anon-key

# Optional. Empty = off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_TURNSTILE_SITE_KEY=
